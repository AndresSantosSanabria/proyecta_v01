# Application Name
spring.application.name=api-gestion

# Database Connection (Configuration)
# Replace with your local or environment values
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:postgres}?currentSchema=${DB_SCHEMA:proyecta_db}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:password}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate Properties
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# Swagger UI
springdoc.swagger-ui.path=/swagger-ui.html

# Dashboard Config
dashboard.ventana-vencimiento=7

# Keycloak / OAuth2 Resource Server
spring.security.oauth2.resourceserver.jwt.issuer-uri=${KEYCLOAK_ISSUER_URI:http://172.20.6.59:8080/realms/gob-cundinamarca-devqa}
spring.security.oauth2.resourceserver.jwt.jwk-set-uri=${KEYCLOAK_JWKS_URI:http://172.20.6.59:8080/realms/gob-cundinamarca-devqa/protocol/openid-connect/certs}
gob.security.resource-client-ids=${GOB_RESOURCE_CLIENT_IDS:proyecta-web}
gob.security.cors.allowed-origins=${GOB_CORS_ORIGINS:http://localhost:5173}
