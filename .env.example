# Copiar a .env y completar. Nunca subir .env a git.
DB_PASSWORD=cambia_esto
DB_USER=cambia_esto
DB_NAME=cambia_esto
DB_SCHEMA=proyecta_db
# Estrategia Hibernate junto a Flyway: validate (recomendado) | update | none
DB_DDL_AUTO=validate

MAIL_PASSWORD=
MAIL_HOST=

KEYCLOAK_ISSUER_URI=
KEYCLOAK_JWKS_URI=

VITE_API_URL=http://localhost:8082
VITE_BASE_PATH=/
VITE_ENABLE_AUTH=true
VITE_KEYCLOAK_BASE_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
# Opcional: si se deja vacio, el frontend deriva la URL desde el origen real
# del navegador (window.location.origin) + VITE_BASE_PATH.
VITE_KEYCLOAK_REDIRECT_URI=
VITE_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=
VITE_KEYCLOAK_RESPONSE_TYPE=code
VITE_KEYCLOAK_SCOPE=openid profile email

APP_FRONTEND_URL_BASE=http://localhost:5173
GOB_CORS_ORIGINS=http://localhost:5173
PUBLIC_EVIDENCE_HMAC_SECRET=dev-secret-change-me
