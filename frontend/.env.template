# ========================================
# CONFIGURACION DE API
# ========================================
VITE_API_URL=

# ========================================
# PREFIJO DE DESPLIEGUE (subruta)
# ========================================
# Vacío o sin definir = raíz del dominio.
# Ejemplo de producción: /apps/proyecta/public/
# Debe coincidir con el <base> público y con el redirect_uri de Keycloak
# (ej. https://saga.cundinamarca.gov.co/apps/proyecta/public/callback).
VITE_BASE_PATH=

# ========================================
# CONFIGURACION DE SEGURIDAD
# ========================================
VITE_ENABLE_AUTH=
# Host del servidor Keycloak (no dejar IPs internas en el repositorio).
# Ej: http://keycloak.cundinamarca.gov.co:8080
VITE_KEYCLOAK_BASE_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
VITE_KEYCLOAK_REDIRECT_URI=
VITE_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=
VITE_KEYCLOAK_RESPONSE_TYPE=code
VITE_KEYCLOAK_SCOPE=openid profile email
