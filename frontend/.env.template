# ========================================
# CONFIGURACIÓN DE API
# ========================================
# URL base del backend API
# Reemplazar con la URL real según el entorno
VITE_API_URL=http://localhost:8080/api/v1

# ========================================
# CONFIGURACIÓN DE SEGURIDAD
# ========================================
# Habilitar/Deshabilitar autenticación
# true: requiere token en localStorage | false: modo desarrollo sin tokens
VITE_ENABLE_AUTH=false

# ========================================
# CONFIGURACIÓN DE APLICACIÓN
# ========================================
# Nombre de la aplicación
# VITE_APP_TITLE=Proyecta

# Modo de aplicación (development, production, staging)
# VITE_APP_MODE=development

# ========================================
# CONFIGURACIÓN DE LOGS
# ========================================
# Nivel de logs (debug, info, warning, error)
# VITE_LOG_LEVEL=info
